                }
              }
            }
          },
          "404": {
            "description": "Sale or product not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Create a user. Only `owner`.",
        "operationId": "create_user_doc",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Role does not permit managing users",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Email is already registered",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input (email or password)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddItemRequest": {
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "string",
            "example": "2"
          }
        }
      },
      "CompletedSaleResponse": {
        "type": "object",
        "required": [
          "sale_id",
          "total",
          "movement_ids",
          "completed_at"
        ],
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "movement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "sale_id": {
            "type": "string",
            "format": "uuid"
          },
          "total": {
            "type": "string"
          }
        }
      },
      "CreateProductRequest": {
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/ProductKind"
          },
          "min_stock": {
            "type": [
              "string",
              "null"
            ],
            "example": "10"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "description": "Documented as `string` although the server also accepts numbers:\n`rust_decimal` deserializes both, but the frontend contract—and the only\none preserving precision—is the string. See `docs/api-contract.md`.",
            "example": "1500.50"
          },
          "sku": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "CreateUserResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DraftResponse": {
        "type": "object",
        "required": [
          "id",
          "reused"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reused": {
            "type": "boolean",
            "description": "`true` if the existing open draft was reused."
          }
        }
      },
      "IdResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "user",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        }
      },
      "MovementReason": {
        "type": "string",
        "description": "Why stock was moved.",
        "enum": [
          "purchase",
          "sale",
          "adjustment",
          "loss"
        ]
      },
      "MovementResponse": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "quantity",
          "signed_quantity",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/MovementReason"
          },
          "signed_quantity": {
            "type": "string",
            "description": "Signed quantity: what the client needs to show the stock effect without\nreplicating the sign rule."
          },
          "unit_cost": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 7807 error body. Same shape for every status code.",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Actionable explanation for the user.",
            "example": "Invalid credentials or expired session."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status, repeated in the body for clients that do not read headers.",
            "example": 401,
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Human-readable, stable summary of the problem.",
            "example": "Unauthorized"
          },
          "type": {
            "type": "string",
            "description": "URI identifying the problem type. Currently always `about:blank`.",
            "example": "about:blank"
          }
        }
      },
      "ProductKind": {
        "type": "string",
        "description": "A catalog item may or may not track stock.",
        "enum": [
          "product",
          "service"
        ]
      },
      "ProductListResponse": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductResponse"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ProductResponse": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_active": {
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/ProductKind"
          },
          "low_stock": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "`null` when not applicable (service) or no threshold is configured."
          },
          "min_stock": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "description": "String, not number: a JSON `float` loses precision for money and\nfractional quantities. The client parses it as a decimal."
          },
          "sku": {
            "type": [
              "string",
              "null"
            ]
          },
          "stock": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` for services: not zero, but \"not applicable\"."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RecordMovementRequest": {
        "type": "object",
        "required": [
          "reason",
          "quantity"
        ],
        "properties": {
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": "string",
            "example": "12.5"
          },
          "reason": {
            "$ref": "#/components/schemas/MovementReason"
          },
          "unit_cost": {
            "type": [
              "string",
              "null"
            ],
            "example": "1200.00"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "manager"
        ]
      },
      "SaleItemResponse": {
        "type": "object",
        "required": [
          "product_id",
          "product_name",
          "quantity",
          "unit_price",
          "subtotal"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "description": "Quantity as a string: `numeric(12,3)` does not fit in a float without\nlosing precision for fractional quantities."
          },
          "subtotal": {
            "type": "string"
          },
          "unit_price": {
            "type": "string"
          }
        }
      },
      "SaleResponse": {
        "type": "object",
        "required": [
          "id",
          "status",
          "items",
          "total",
          "item_count",
          "created_at"
        ],
        "properties": {
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "item_count": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleItemResponse"
            }
          },
          "status": {
            "$ref": "#/components/schemas/SaleStatus"
          },
          "total": {
            "type": "string",
            "description": "Calculated on the server. The client displays it, not decides it."
          }
        }
      },
      "SaleStatus": {
        "type": "string",
        "enum": [
          "draft",
          "completed",
          "cancelled"
        ]
      },
      "SetQuantityRequest": {
        "type": "object",
        "required": [
          "quantity"
        ],
        "properties": {
          "quantity": {
            "type": "string",
            "example": "3"
          }
        }
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_active": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "min_stock": {
            "type": [
              "string",
              "null"
            ],
            "example": "10"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "example": "1500.50"
          },
          "sku": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Sessions and users"
    },
    {
      "name": "catalog",

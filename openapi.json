{
  "openapi": "3.1.0",
  "info": {
    "title": "organox",
    "description": "Administrador de negocio para una PyME (stock e insumos). Single-tenant.\n\n**Autenticación**: salvo `POST /api/v1/auth/login`, toda ruta requiere la cookie de sesión `session` (HttpOnly, SameSite=Strict). Sin ella devuelve `401`.\n\n**Errores**: todas las respuestas de error usan `application/problem+json` (RFC 7807). El `429` incluye además el header `Retry-After` en segundos.\n\n**Decimales**: viajan siempre como **string** (`\"1500.50\"`, `\"12.5\"`), nunca como número, para no perder precisión.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Inicia sesión.",
        "description": "Devuelve la cookie `session` (HttpOnly, SameSite=Strict) y el usuario.\n\n`429` significa cuenta bloqueada por intentos fallidos; incluye\n`Retry-After` con los segundos que faltan.",
        "operationId": "login_doc",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "session=<token>; HttpOnly; SameSite=Strict"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Cuenta bloqueada por intentos fallidos",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Segundos hasta poder reintentar"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Cierra la sesión en el servidor, no solo en el cliente.",
        "operationId": "logout_doc",
        "responses": {
          "204": {
            "description": "Sesión borrada"
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },

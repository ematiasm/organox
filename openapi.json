{
  "openapi": "3.1.0",
  "info": {
    "title": "organox",
    "description": "Business administration for a small or medium enterprise (stock and supplies). Single-tenant.\n\n**Authentication**: except `POST /api/v1/auth/login`, every route requires the `session` cookie (HttpOnly, SameSite=Strict). Without it, routes return `401`.\n\n**Errors**: all error responses use `application/problem+json` (RFC 7807). A `429` also includes the `Retry-After` header in seconds.\n\n**Decimals**: always transmitted as **strings** (`\"1500.50\"`, `\"12.5\"`), never numbers, to avoid losing precision.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in.",
        "description": "Returns the `session` cookie (HttpOnly, SameSite=Strict) and the user.\n\n`429` means the account is locked after failed attempts; includes\n`Retry-After` with the remaining seconds.",
        "operationId": "login_doc",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Session started",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "session=<token>; HttpOnly; SameSite=Strict"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Account locked after failed attempts",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Seconds until retry"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the session on the server, not just the client.",
        "operationId": "logout_doc",
        "responses": {
          "204": {
            "description": "Session deleted"
          },
          "401": {
            "description": "No session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Authenticated user in the current request.",
        "operationId": "me_doc",
        "responses": {

        "tags": [
          "sales"
        ],
        "summary": "Quita un ítem del borrador.",
        "operationId": "remove_item_doc",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id de la venta",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "product_id",
            "in": "path",
            "description": "Id del producto",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Venta actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaleResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Venta o producto inexistente",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Crea un usuario. Solo `owner`.",
        "operationId": "create_user_doc",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Usuario creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateUserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "El rol no permite gestionar usuarios",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "El email ya está registrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Entrada inválida (email o contraseña)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddItemRequest": {
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "string",
            "example": "2"
          }
        }
      },
      "CompletedSaleResponse": {
        "type": "object",
        "required": [
          "sale_id",
          "total",
          "movement_ids",
          "completed_at"
        ],
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "movement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "sale_id": {
            "type": "string",
            "format": "uuid"
          },
          "total": {
            "type": "string"
          }
        }
      },
      "CreateProductRequest": {
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/ProductKind"
          },
          "min_stock": {
            "type": [
              "string",
              "null"
            ],
            "example": "10"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "description": "Se documenta como `string` aunque el servidor también acepte números:\n`rust_decimal` deserializa ambos, pero el contrato que el frontend debe\nusar —y el único que preserva precisión— es el string. Ver\n`docs/api-contract.md`.",
            "example": "1500.50"
          },
          "sku": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "CreateUserResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DraftResponse": {
        "type": "object",
        "required": [
          "id",
          "reused"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reused": {
            "type": "boolean",
            "description": "`true` si se reutilizó el borrador que ya estaba abierto."
          }
        }
      },
      "IdResponse": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "user",
          "expires_at"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        }
      },
      "MovementReason": {
        "type": "string",
        "description": "Por qué se movió el stock.",
        "enum": [
          "purchase",
          "sale",
          "adjustment",
          "loss"
        ]
      },
      "MovementResponse": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "quantity",
          "signed_quantity",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/MovementReason"
          },
          "signed_quantity": {
            "type": "string",
            "description": "La cantidad con signo: es lo que el cliente necesita para mostrar el\nefecto en el stock sin replicar la regla de signos."
          },
          "unit_cost": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "Cuerpo de error RFC 7807. Mismo shape para todos los códigos.",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Explicación accionable para el usuario.",
            "example": "Credenciales inválidas o sesión vencida."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "Código HTTP, repetido en el cuerpo para clientes que no leen headers.",
            "example": 401,
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Resumen legible y estable del problema.",
            "example": "Unauthorized"
          },
          "type": {
            "type": "string",
            "description": "URI que identifica el tipo de problema. Siempre `about:blank` hoy.",
            "example": "about:blank"
          }
        }
      },
      "ProductKind": {
        "type": "string",
        "description": "Un ítem del catálogo puede llevar stock o no.",
        "enum": [
          "product",
          "service"
        ]
      },
      "ProductListResponse": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductResponse"
            }
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "offset": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ProductResponse": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_active": {
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/ProductKind"
          },
          "low_stock": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "`null` cuando no aplica (servicio) o no hay umbral configurado."
          },
          "min_stock": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "description": "String, no número: un `float` en JSON pierde precisión en dinero y en\ncantidades fraccionarias. El cliente lo parsea como decimal."
          },
          "sku": {
            "type": [
              "string",
              "null"
            ]
          },
          "stock": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` para servicios: no es cero, es \"no aplica\"."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RecordMovementRequest": {
        "type": "object",
        "required": [
          "reason",
          "quantity"
        ],
        "properties": {
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantity": {
            "type": "string",
            "example": "12.5"
          },
          "reason": {
            "$ref": "#/components/schemas/MovementReason"
          },
          "unit_cost": {
            "type": [
              "string",
              "null"
            ],
            "example": "1200.00"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "encargado"
        ]
      },
      "SaleItemResponse": {
        "type": "object",
        "required": [
          "product_id",
          "product_name",
          "quantity",
          "unit_price",
          "subtotal"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "description": "Cantidad como string: `numeric(12,3)` no cabe en un float sin perder\nprecisión en cantidades fraccionarias."
          },
          "subtotal": {
            "type": "string"
          },
          "unit_price": {
            "type": "string"
          }
        }
      },
      "SaleResponse": {
        "type": "object",
        "required": [
          "id",
          "status",
          "items",
          "total",
          "item_count",
          "created_at"
        ],
        "properties": {
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "item_count": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaleItemResponse"
            }
          },
          "status": {
            "$ref": "#/components/schemas/SaleStatus"
          },
          "total": {
            "type": "string",
            "description": "Calculado en el servidor. El cliente lo muestra, no lo decide."
          }
        }
      },
      "SaleStatus": {
        "type": "string",
        "enum": [
          "draft",
          "completed",
          "cancelled"
        ]
      },
      "SetQuantityRequest": {
        "type": "object",
        "required": [
          "quantity"
        ],
        "properties": {
          "quantity": {
            "type": "string",
            "example": "3"
          }
        }
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_active": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "min_stock": {
            "type": [
              "string",
              "null"
            ],
            "example": "10"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "type": [
              "string",
              "null"
            ],
            "example": "1500.50"
          },
          "sku": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Sesión y usuarios"
    },
    {
      "name": "catalog",
      "description": "Productos, servicios y libro de stock"
    },
    {
      "name": "sales",
      "description": "Carrito persistido y cobro"
    }
  ]
}

# Copy to .env and adjust. NEVER commit .env.

# --- db ---
DATABASE_URL=postgres://organox:organox_dev_password@localhost:5432/organox

# --- Server ---
APP_BIND_ADDR=0.0.0.0:3000
APP_LOG_FORMAT=pretty
# Secure cookie: true in production (HTTPS). In dev with http://localhost, false.
APP_COOKIE_SECURE=false
# --- Login rate limiting ---
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_BLOCK_MINUTES=5
APP_LOGIN_IP_MAX_PER_MINUTE=30
APP_RUST_LOG=organox=debug,tower_http=debug,sqlx=warn

# Copiar a .env y ajustar. NUNCA commitear .env.

# --- Base de datos ---
DATABASE_URL=postgres://admin_app:admin_app_dev_password@localhost:5432/admin_app

# --- Servidor ---
APP_BIND_ADDR=0.0.0.0:3000
APP_LOG_FORMAT=pretty
# Cookie Secure: true en produccion (HTTPS). En dev con http://localhost, false.
APP_COOKIE_SECURE=false
# --- Rate limiting de login ---
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_BLOCK_MINUTES=5
APP_LOGIN_IP_MAX_PER_MINUTE=30
APP_RUST_LOG=admin_app=debug,tower_http=debug,sqlx=warn

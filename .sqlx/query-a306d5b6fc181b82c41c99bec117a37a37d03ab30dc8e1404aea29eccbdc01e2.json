  "query": "\n        SELECT si.product_id, si.quantity, si.unit_price, p.name\n        FROM sale_items si\n        JOIN products p ON p.id = si.product_id\n        WHERE si.sale_id = $1\n        ORDER BY si.product_id\n        ",

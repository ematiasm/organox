{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT si.id, si.product_id, p.name AS \"product_name!\", si.quantity, si.unit_price\n        FROM sale_items si\n        JOIN products p ON p.id = si.product_id\n        WHERE si.sale_id = $1\n        ORDER BY si.created_at, si.id\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    failed_count,\n                    blocked_until,\n                    (blocked_until IS NOT NULL AND blocked_until > now()) AS \"is_blocked!\",\n                    (blocked_until IS NOT NULL AND blocked_until <= now()) AS \"lock_expired!\",\n                    (window_start + make_interval(secs => $2) < now()) AS \"window_expired!\"\n                FROM login_attempts\n                WHERE email = $1\n                ",

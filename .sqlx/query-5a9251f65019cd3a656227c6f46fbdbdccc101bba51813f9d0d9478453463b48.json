{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.status AS \"status: PurchaseStatus\",\n            p.total,\n            p.supplier_id,\n            COALESCE(p.supplier_name, s.name) AS supplier_name,\n            p.note,\n            p.created_by,\n            p.created_at,\n            p.completed_at\n        FROM purchases p\n        LEFT JOIN suppliers s ON s.id = p.supplier_id\n        WHERE p.id = $1\n        ",

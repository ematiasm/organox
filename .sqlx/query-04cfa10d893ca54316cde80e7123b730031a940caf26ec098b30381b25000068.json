  "db_name": "PostgreSQL",
  "query": "\n        SELECT pm.id,\n               pm.name,\n               pm.wallet_id,\n               w.name AS \"wallet_name!\",\n               w.is_active AS \"wallet_is_active!\",\n               pm.is_active,\n               pm.created_at,\n               pm.updated_at\n        FROM payment_methods pm\n        JOIN wallets w ON w.id = pm.wallet_id\n        WHERE pm.id = $1\n        ",

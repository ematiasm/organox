{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.status AS \"status: PurchaseStatus\",\n               p.total,\n               p.supplier_id,\n               COALESCE(p.supplier_name, s.name) AS supplier_name\n        FROM purchases p\n        LEFT JOIN suppliers s ON s.id = p.supplier_id\n        WHERE p.id = $1\n        ",

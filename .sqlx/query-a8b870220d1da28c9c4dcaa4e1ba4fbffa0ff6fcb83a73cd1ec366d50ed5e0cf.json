{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id,\n               supplier_id,\n               kind AS \"kind: SupplierAccountEntryKind\",\n               amount,\n               purchase_id,\n               purchase_return_id,\n               wallet_movement_id,\n               note,\n               created_by,\n               created_at,\n               (SUM(amount) OVER (\n                   ORDER BY created_at ASC, id ASC\n                   ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n               ))::numeric(14, 2) AS \"running_balance!: Decimal\",\n               COUNT(*) OVER () AS \"entries_total!\"\n        FROM supplier_account_entries\n        WHERE supplier_id = $1\n        ORDER BY created_at ASC, id ASC\n        LIMIT $2 OFFSET $3\n        ",

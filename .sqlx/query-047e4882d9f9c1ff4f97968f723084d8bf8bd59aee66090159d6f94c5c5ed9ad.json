  "db_name": "PostgreSQL",
  "query": "\n        SELECT pri.id,\n               pri.purchase_return_id,\n               pri.product_id,\n               p.name AS \"product_name!\",\n               pri.quantity,\n               pri.unit_cost\n        FROM purchase_return_items pri\n        JOIN products p ON p.id = pri.product_id\n        WHERE pri.purchase_return_id = ANY($1)\n        ORDER BY p.name, pri.id\n        ",

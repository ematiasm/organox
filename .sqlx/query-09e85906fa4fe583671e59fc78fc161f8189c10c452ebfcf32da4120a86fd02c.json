  "db_name": "PostgreSQL",
  "query": "\n            SELECT cni.id,\n                   cni.credit_note_id,\n                   cni.product_id,\n                   p.name AS \"product_name!\",\n                   cni.quantity,\n                   cni.unit_price\n            FROM credit_note_items cni\n            JOIN products p ON p.id = cni.product_id\n            WHERE cni.credit_note_id = ANY($1)\n            ORDER BY p.name, cni.id\n            ",

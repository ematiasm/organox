  "query": "\n        SELECT id,\n               wallet_id,\n               kind AS \"kind: WalletMovementKind\",\n               amount,\n               sale_id,\n               payment_method_id,\n               note,\n               created_by,\n               created_at\n        FROM wallet_movements\n        WHERE wallet_id = $1\n        ORDER BY created_at DESC, id DESC\n        LIMIT $2\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT w.id,\n               w.name,\n               w.is_active,\n               w.created_at,\n               w.updated_at,\n               COALESCE(SUM(\n                   CASE\n                       WHEN m.kind = 'sale_payment' THEN m.amount\n                       WHEN m.kind = 'adjustment_in' THEN m.amount\n                       ELSE -m.amount\n                   END\n               ), 0)::numeric(14, 2) AS \"balance!: Decimal\"\n        FROM wallets w\n        LEFT JOIN wallet_movements m ON m.wallet_id = w.id\n        WHERE w.id = $1\n        GROUP BY w.id, w.name, w.is_active, w.created_at, w.updated_at\n        ",

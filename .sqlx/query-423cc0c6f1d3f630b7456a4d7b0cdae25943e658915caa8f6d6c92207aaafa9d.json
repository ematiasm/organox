  "db_name": "PostgreSQL",
  "query": "\n        SELECT id AS entry_id,\n               kind AS \"kind: SupplierAccountEntryKind\",\n               amount,\n               note AS \"note!: String\",\n               created_by,\n               created_at\n        FROM supplier_account_entries\n        WHERE supplier_id = $1\n          AND kind IN ('adjustment_in', 'adjustment_out')\n        ORDER BY created_at DESC, id DESC\n        LIMIT $2\n        OFFSET $3\n        ",

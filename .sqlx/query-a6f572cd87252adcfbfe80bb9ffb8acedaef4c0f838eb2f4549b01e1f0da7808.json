  "query": "\n            SELECT cn.id,\n                   cn.sale_id,\n                   cn.reason,\n                   cn.total,\n                   cn.created_by,\n                   cn.created_at AS \"created_at!\"\n            FROM credit_notes cn\n            WHERE cn.sale_id = $1 AND cn.idempotency_key = $2\n            ORDER BY cn.created_at, cn.id\n            ",

  "query": "\n            SELECT pr.id,\n                   pr.purchase_id,\n                   pr.total,\n                   pr.surplus_mode AS \"surplus_mode: SurplusMode\",\n                   pr.reason,\n                   pr.created_by,\n                   pr.created_at AS \"created_at!\"\n            FROM purchase_returns pr\n            WHERE pr.purchase_id = $1\n            ORDER BY pr.created_at, pr.id\n            ",

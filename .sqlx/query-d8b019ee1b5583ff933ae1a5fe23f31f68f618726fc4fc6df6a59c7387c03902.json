{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.email::text AS \"email!\", u.role AS \"role: Role\"\n        FROM sessions s\n        JOIN users u ON u.id = s.user_id\n        WHERE s.token_hash = $1\n          AND s.expires_at > now()\n        ",

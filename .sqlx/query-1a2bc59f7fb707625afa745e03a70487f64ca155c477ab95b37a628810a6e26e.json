{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.kind AS \"kind: ProductKind\",\n            p.sku,\n            p.name,\n            p.description,\n            p.price,\n            p.min_stock,\n            p.is_active,\n            p.created_at,\n            p.updated_at,\n            s.stock\n        FROM products p\n        LEFT JOIN LATERAL (\n            SELECT COALESCE(SUM(\n                CASE m.reason\n                    WHEN 'purchase'   THEN m.quantity\n                    WHEN 'adjustment' THEN m.quantity\n                    WHEN 'sale'       THEN -m.quantity\n                    WHEN 'loss'       THEN -m.quantity\n                END\n            ), 0) AS stock\n            FROM stock_movements m\n            WHERE m.product_id = p.id\n        ) s ON true\n        WHERE p.id = $1\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            pi.id,\n            pi.purchase_id,\n            pi.product_id,\n            pr.name AS product_name,\n            pi.quantity,\n            pi.unit_cost\n        FROM purchase_items pi\n        JOIN products pr ON pr.id = pi.product_id\n        WHERE pi.purchase_id = ANY($1)\n        ORDER BY pi.created_at ASC, pi.id ASC\n        ",

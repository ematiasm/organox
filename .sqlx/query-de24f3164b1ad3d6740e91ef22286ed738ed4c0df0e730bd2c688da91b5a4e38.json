{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.id,\n            s.name,\n            s.tax_id,\n            s.email,\n            s.phone,\n            s.is_active,\n            s.created_at,\n            s.updated_at,\n            COUNT(*) OVER () AS \"total!\"\n        FROM suppliers s\n        WHERE ($1::bool OR s.is_active)\n          AND (\n                $2::text IS NULL\n                OR s.name ILIKE $2::text ESCAPE E'\\\\'\n                OR s.tax_id ILIKE $2::text ESCAPE E'\\\\'\n          )\n        ORDER BY lower(s.name), s.id\n        LIMIT $3 OFFSET $4\n        ",

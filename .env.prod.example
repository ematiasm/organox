# Deployment template. Copy to `.env` on the machine that runs the app:
#
#   cp .env.prod.example .env
#
# `docker compose -f compose.prod.yaml` reads `.env` from its own directory.
# There is exactly one `.env` per machine because two files with a database
# password are two places for it to disagree with itself; this file is only the
# template for machines that deploy. `.env.example` documents development.
#
# NEVER commit `.env`.

# --- Database ---
# The single source of the database password: `compose.prod.yaml` builds
# DATABASE_URL from it, so the two can never disagree.
# URL-safe characters only (letters, digits, `-`, `_`), because it is
# interpolated into a connection URL.
# Generate with: openssl rand -base64 24 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=

# --- App ---
# Port published on the LAN. The app is reached at http://<host-lan-ip>:3000
APP_PORT=3000
APP_LOG_FORMAT=json
# Must stay `false` while the app is reached over plain HTTP (`http://`),
# including the tailnet IP. A `Secure` cookie is silently dropped by the browser
# over HTTP: the login appears to succeed and every later request returns 401.
# Set it to `true` only with TLS in front of the app.
APP_COOKIE_SECURE=false

# --- Login rate limiting (optional, these are the defaults) ---
# APP_LOGIN_MAX_FAILURES=5
# APP_LOGIN_BLOCK_MINUTES=5
# APP_LOGIN_IP_MAX_PER_MINUTE=30

# --- Backups (host, not the app) ---
# Read by scripts/backup.sh and scripts/install-timer.sh. The app itself never
# sees these; see docs/backup.md.
# Destination on the host. Changing it starts a fresh retention policy in the
# new directory, so move the old dumps by hand (docs/backup.md, "Changing the
# destination").
# BACKUP_DIR=$HOME/organox-backups
# BACKUP_DAILY_KEEP=14
# BACKUP_MONTHLY_KEEP=12
# When the timer fires (systemd OnCalendar syntax).
# BACKUP_ON_CALENDAR=*-*-* 03:00:00
